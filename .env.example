# Copy this file to .env and fill in your own values. Never commit .env.

# U.S. Census Bureau API key, needed by pipeline/fetch_acs.py and validation/validate.py.
# Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Anthropic API key for the research assistant (api/agent.py, POST /api/chat).
# Create one at https://platform.claude.com/settings/keys . Each question costs a few cents.
ANTHROPIC_API_KEY=

# Optional: the Claude model and effort level the assistant uses.
# KYD_MODEL=claude-opus-5-5
# KYD_EFFORT=medium

# Research assistant security (api/security.py; see SECURITY.md). All optional.
# Secret used to sign the assistant's answers. Set a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, one is generated once and kept in data/chat_signing.key (not in git).
# CHAT_SIGNING_KEY=
# CHAT_PER_MINUTE=10        # questions per visitor per minute
# CHAT_PER_HOUR=60          # questions per visitor per hour
# CHAT_MAX_CONCURRENT=4     # questions answered at the same time
# CHAT_DAILY_LIMIT=500      # questions per day, all visitors together
# CHAT_DAILY_USD=5.00       # estimated AI spending per day, all visitors together
# CHAT_QUESTION_USD=0.50    # estimated AI spending for one question
# Prices in US dollars per million tokens, used for those estimates (defaults: Claude Opus 5.5).
# Update them if you change KYD_MODEL or Anthropic changes its prices.
# CHAT_PRICE_INPUT=4.00
# CHAT_PRICE_OUTPUT=20.00
# CHAT_PRICE_CACHE_READ=0.20
# CHAT_PRICE_CACHE_WRITE=5.00
# TRUST_PROXY=0             # set to 1 only behind a reverse proxy that sets X-Forwarded-For

# Interactive API docs at /docs. Set to 0 in production.
# API_DOCS=1
